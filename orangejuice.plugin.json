{
  "schemaVersion": 1,
  "title": "服务器状态",
  "description": "框架独立的 Linux 状态采集和 PNG 看板；附带主人专用 Yunzai 命令适配。",
  "homepage": "https://github.com/719083594/ServerStatus-Plugin",
  "commands": [
    "#系统",
    "/系统",
    "#资源",
    "#存储",
    "#插件",
    "#服务",
    "#系统帮助"
  ],
  "configs": [
    {
      "id": "plugin",
      "title": "机器人请求配置",
      "file": "config/plugin.json",
      "example": "config/plugin.example.json",
      "reload": "restart",
      "fields": [
        {
          "path": "ipcDirectory",
          "label": "采集器通信目录（机器人可访问的路径）",
          "type": "string"
        }
      ]
    },
    {
      "id": "collector-example",
      "title": "采集器部署参考",
      "file": "collector/config.example.json",
      "readonly": true,
      "reload": "restart",
      "fields": [
        {"path":"applicationRoot","label":"应用根目录","type":"string"},
        {"path":"yunzaiRoot","label":"旧版应用根目录（兼容旧配置）","type":"string"},
        {"path":"ipcDirectory","label":"采集器通信目录（宿主机路径）","type":"string"},
        {"path":"fontPath","label":"中文字体文件路径","type":"string"},
        {"path":"dockerMode","label":"容器监测模式（auto 自动发现 / selected 指定容器 / off 关闭）","type":"string"},
        {"path":"containers","label":"指定监测的容器列表","description":"每项包含 name（实际容器名称）和 label（中文显示名称）。","type":"array"},
        {"path":"storageDirectories","label":"统计容量的数据目录列表","description":"每项包含 path（目录路径）和 label（中文显示名称）。","type":"array"},
        {"path":"storageCacheSeconds","label":"存储统计缓存时间（秒）","type":"integer","min":5},
        {"path":"programCacheSeconds","label":"应用目录统计缓存时间（秒）","type":"integer","min":60},
        {"path":"cleanup.enabled","label":"启用定时清理","type":"boolean"},
        {"path":"cleanup.scheduleTime","label":"每日清理时间（北京时间，时:分）","type":"string"},
        {"path":"cleanup.pruneUnusedImages","label":"清理过期且未使用的容器镜像","type":"boolean"},
        {"path":"cleanup.imageAgeHours","label":"未使用镜像的保留时间（小时）","type":"integer","min":24,"max":87600},
        {"path":"cleanup.pruneBuildCache","label":"清理过期构建缓存","type":"boolean"},
        {"path":"cleanup.buildCacheAgeHours","label":"构建缓存的保留时间（小时）","type":"integer","min":24,"max":87600},
        {"path":"cleanup.buildCacheKeepGB","label":"至少保留的构建缓存容量（GB）","type":"integer","min":0,"max":100},
        {"path":"cleanup.cleanTemporaryFiles","label":"清理过期临时文件","type":"boolean"},
        {"path":"cleanup.temporaryMaxAgeHours","label":"临时文件的保留时间（小时）","type":"integer","min":24,"max":87600},
        {"path":"cleanup.cleanRotatedLogs","label":"清理过期轮转日志","type":"boolean"},
        {"path":"cleanup.rotatedLogMaxAgeHours","label":"轮转日志的保留时间（小时）","type":"integer","min":24,"max":87600}
      ]
    }
  ]
}
